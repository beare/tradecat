[Unit]
Description=Fate-Engine Telegram Bot
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=%u
WorkingDirectory=%h/.projects/fate-engine/services/telegram-service
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=%h/.projects/fate-engine-env/.env
ExecStart=/bin/bash -lc 'source %h/.projects/fate-engine/.venv/bin/activate && python start.py bot'
Restart=always
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
