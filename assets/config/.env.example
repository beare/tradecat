# ============================================================
# TradeCat 配置模板
# ============================================================
# 
# 使用方法：
#   1. 复制此文件为 .env：cp .env.example .env
#   2. 修改 .env 中的配置值
#   3. 设置权限：chmod 600 .env
#   4. 重启服务生效
# 
# 注意：.env 包含敏感信息，已在 .gitignore 中排除
# 
# ============================================================

# ============================================================
# 网络代理
# ============================================================
# 用于访问 Binance API 和 Telegram API（国内需要代理）
# 格式：http://IP:端口 或 socks5://IP:端口
# 留空则不使用代理
HTTP_PROXY=
HTTPS_PROXY=

# predict-service 可选默认代理（当 HTTP_PROXY/HTTPS_PROXY 未设置时生效）
DEFAULT_PROXY_URL=
POLYMARKET_PROXY=
OPINION_PROXY=

# live monitor 可选 API 地址覆盖
POLYMARKET_CLOB_API_BASE=https://clob.polymarket.com
POLYMARKET_GAMMA_API_BASE=https://gamma-api.polymarket.com
POLYMARKET_DATA_API_BASE=https://data-api.polymarket.com
POLYMARKET_WEB_BASE=https://polymarket.com
KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2
KALSHI_WS_BASE=wss://api.elections.kalshi.com
KALSHI_WEB_BASE=https://kalshi.com
CLOB_API_BASE=https://clob.polymarket.com
GAMMA_API_BASE=https://gamma-api.polymarket.com
DATA_API_BASE=https://data-api.polymarket.com
OPINION_WEB_BASE=https://opinion.trade
TELEGRAM_API_BASE=https://api.telegram.org

# ============================================================
# Coinglass / Hyper 抓取（hyper-service）
# ============================================================
# hyper-service 默认通过 Hyperliquid leaderboard 拉取地址快照；可选使用 Coinglass 解密链路。
#
# 说明：
#
# HYPERLIQUID_ADDRESS_SOURCE：
# - leaderboard（默认）：读取 https://stats-data.hyperliquid.xyz/Mainnet/leaderboard，不需要任何 key
# - coinglass：走 CoinGlass 解密链路（需要 COINGLASS_OBE/COINGLASS_HEADERS_JSON）
HYPERLIQUID_ADDRESS_SOURCE=leaderboard
#
# - 该接口需要请求头包含 `obe`（不要把真实值提交到仓库）
# - 优先级：COINGLASS_HEADERS_JSON > COINGLASS_OBE
#
# COINGLASS_HEADERS_JSON：
# - 完整 headers JSON（object），原样透传到请求头（建议生产使用）
# - 例：{"obe":"...","user-agent":"Mozilla/5.0 ..."}
#
# COINGLASS_OBE：
# - 只提供 obe 值（最小配置），其余 header 由代码补齐
#
# COINGLASS_UA：
# - 可选 UA（仅在使用 COINGLASS_OBE 时拼入；使用 COINGLASS_HEADERS_JSON 时以 JSON 为准）
COINGLASS_OBE=
COINGLASS_HEADERS_JSON=
COINGLASS_UA=

# 数据库连接（默认：单实例单端口；facts / derived 双库）
#
# 默认 TimescaleDB@5433，主要对象：
# - facts_data：core 事实数据（market / alternative / 导入治理）
# - derived_data：plugins 派生数据（indicator_snapshots / signal_runtime）
FACTS_DATABASE_URL=postgresql://<user>:<pass>@<host>:<port>/facts_data
DERIVED_DATABASE_URL=postgresql://<user>:<pass>@<host>:<port>/derived_data

# 兼容旧服务：未完成双库拆分前，DATABASE_URL 仍指向 facts_data
DATABASE_URL=postgresql://<user>:<pass>@<host>:<port>/facts_data

# lf-service 专用库（facts；留空则复用 FACTS_DATABASE_URL / DATABASE_URL）
DATA_SERVICE_DATABASE_URL=postgresql://<user>:<pass>@<host>:<port>/facts_data

# HF（高频/HFT 原子事实库）：默认与 DATABASE_URL 同库同端口（单集群）
# - 若你坚持“LF/HF 双集群”：把此值改为 HF 实例的 DSN（并同步脚本/文档/服务配置）
BINANCE_HF_DATABASE_URL=postgresql://<user>:<pass>@<host>:<port>/facts_data

# ============================================================
# Binance Stack（core/market/binance）
# ============================================================
# 说明：
# - LF（低频/分时）：core/market/binance（运行分组 lf；1m K线 + 5m 指标）
# - HF（高频/原子事实）：core/market/binance（运行分组 hf；官方历史归档源对齐 trades/bookTicker/bookDepth）
#
# Binance Stack 编排入口：
# - core/market/binance/scripts/start.sh
#
# 开关：
# - 默认只启 LF；HF 必须显式开启（避免高频默认跑炸机器）
BINANCE_STACK_ENABLE_LF=1
BINANCE_STACK_ENABLE_HF=0
BINANCE_STACK_DRY_RUN=0
#
# HF 运行参数（主契约）：
BINANCE_HF_SERVICE_MODE=
BINANCE_HF_CANARY_SMOKE_SECONDS=120
BINANCE_HF_CANARY_EVIDENCE_DIR=
#
# collect（实时）
BINANCE_HF_COLLECT_DATASET=
BINANCE_HF_COLLECT_SYMBOLS=
BINANCE_HF_COLLECT_NO_CSV=0
BINANCE_HF_COLLECT_NO_DB=0
BINANCE_HF_COLLECT_FLUSH_MAX_ROWS=2000
BINANCE_HF_COLLECT_FLUSH_INTERVAL=1.0
BINANCE_HF_COLLECT_WINDOW_SECONDS=300
BINANCE_HF_COLLECT_REST_OVERLAP_MULTIPLIER=3
BINANCE_HF_COLLECT_GAP_THRESHOLD_SECONDS=30
BINANCE_HF_COLLECT_GAP_CHECK_INTERVAL=10.0
BINANCE_HF_COLLECT_ORDERBOOK_LIMIT=1000
BINANCE_HF_COLLECT_EMIT_INTERVAL=5.0
#
# backfill（历史）
BINANCE_HF_BACKFILL_DATASET=
BINANCE_HF_BACKFILL_SYMBOLS=
BINANCE_HF_BACKFILL_START_DATE=
BINANCE_HF_BACKFILL_END_DATE=
BINANCE_HF_BACKFILL_NO_FILES=0
BINANCE_HF_BACKFILL_NO_DB=0
BINANCE_HF_BACKFILL_NO_PREFER_MONTHLY=0
BINANCE_HF_BACKFILL_ALLOW_NO_CHECKSUM=0
BINANCE_HF_BACKFILL_LOCAL_ONLY=0
BINANCE_HF_BACKFILL_FORCE_UPDATE=0
BINANCE_HF_BACKFILL_WORKERS=1
#
# repair（缺口修复）
BINANCE_HF_REPAIR_DATASET=
BINANCE_HF_REPAIR_SYMBOLS=
BINANCE_HF_REPAIR_MAX_JOBS=10
BINANCE_HF_REPAIR_NO_FILES=0
BINANCE_HF_REPAIR_NO_PREFER_MONTHLY=0
BINANCE_HF_REPAIR_ALLOW_NO_CHECKSUM=0
#
# dataset 细开关（控制面真相）
BINANCE_DATASET_FUTURES_UM_CANDLES_1M_ENABLED=1
BINANCE_DATASET_FUTURES_UM_METRICS_SNAPSHOT_5M_ENABLED=1
BINANCE_DATASET_FUTURES_UM_TRADES_ENABLED=0
BINANCE_DATASET_FUTURES_UM_BOOK_TICKER_ENABLED=0
BINANCE_DATASET_FUTURES_UM_BOOK_DEPTH_ENABLED=0
BINANCE_DATASET_SPOT_TRADES_ENABLED=0
BINANCE_DATASET_SPOT_CANDLES_1M_ENABLED=0
#
# 兼容旧名（迁移期自动兼容；不要在新配置里继续使用）
# BINANCE_DATASET_CANDLES_1M_ENABLED=1
# BINANCE_DATASET_FUTURES_METRICS_5M_ENABLED=1
# BINANCE_DATASET_FUTURES_UM_METRICS_ATOMIC_ENABLED=0


# 单集群模式（默认）：
# - 只设置 DATABASE_URL 即可；上面两个 *_DATABASE_URL 默认与其一致（也可留空复用）。
# - DDL 初始化入口：
#   - facts_data  -> assets/database/db/stacks/facts.sql
#   - derived_data -> assets/database/db/stacks/derived.sql

# ============================================================
# 数据库对象命名剩余兼容键（中央 contracts 之外的少量动态对象）
# ============================================================
# 当前目标真相源：
# - `assets/contracts/resources.v1.yaml`
# - `assets/contracts/probes.v1.yaml`
# - `assets/contracts/bindings.v1.yaml`
#
# 本节定位：
# - 只保留尚未进入中央 contracts 的动态对象名与少量遗留对象名
# - 已进入中央 contracts 的 canonical object name 不再写在 `.env`
#
# 约束：
# - 允许保留：数据库名、连接、token、feature flag
# - 兼容保留：少量 `DB_SCHEMA_*` 与未迁入中央 contracts 的 `DB_TABLE_*`
# - 禁止新增：已进入中央 contracts 的对象命名 env 键
# - 不展开 `indicator_snapshots` 下 38 张指标表名
#
# 迁移顺序：
# - Phase 1: 新对象只允许先进入 `assets/contracts/*`
# - Phase 2: runtime / service 停止直接读取已迁入对象的命名 env
# - Phase 3: 当前已完成 central-covered object 的模板清理；本节仅剩非 central 动态对象
# - Phase 4: 完成外部依赖审计后，继续删除剩余兼容键

# 数据库名
DB_NAME_FACTS=facts_data
DB_NAME_DERIVED=derived_data

# schema 名
DB_SCHEMA_MARKET=market
DB_SCHEMA_ALTERNATIVE=alternative
DB_SCHEMA_INDICATOR=indicator_snapshots
DB_SCHEMA_SIGNAL=signal_runtime
DB_SCHEMA_GOVERNANCE=governance

# market：未迁入 central contracts 的动态 K线 / 指标汇总表
DB_TABLE_MARKET_CANDLES_3M=binance_candles_3m
DB_TABLE_MARKET_CANDLES_5M=binance_candles_5m
DB_TABLE_MARKET_CANDLES_15M=binance_candles_15m
DB_TABLE_MARKET_CANDLES_30M=binance_candles_30m
DB_TABLE_MARKET_CANDLES_1H=binance_candles_1h
DB_TABLE_MARKET_CANDLES_2H=binance_candles_2h
DB_TABLE_MARKET_CANDLES_4H=binance_candles_4h
DB_TABLE_MARKET_CANDLES_6H=binance_candles_6h
DB_TABLE_MARKET_CANDLES_12H=binance_candles_12h
DB_TABLE_MARKET_CANDLES_1D=binance_candles_1d
DB_TABLE_MARKET_CANDLES_1W=binance_candles_1w

DB_TABLE_MARKET_FUTURES_METRICS_15M_LAST=binance_futures_metrics_15m_last
DB_TABLE_MARKET_FUTURES_METRICS_1H_LAST=binance_futures_metrics_1h_last
DB_TABLE_MARKET_FUTURES_METRICS_4H_LAST=binance_futures_metrics_4h_last
DB_TABLE_MARKET_FUTURES_METRICS_1D_LAST=binance_futures_metrics_1d_last
DB_TABLE_MARKET_FUTURES_METRICS_1W_LAST=binance_futures_metrics_1w_last

# market：残留兼容对象
DB_TABLE_MARKET_FUTURES_UM_METRICS_ATOMIC=binance_futures_um_metrics_atomic

# derived：残留兼容对象（central-covered 对象已移出模板）
DB_TABLE_INDICATOR_BASE=基础数据同步器.py

# 文件态运行路径

# ============================================================
# Query Service（api-service，consumption 唯一读出口）
# ============================================================
# consumption 层（telegram/sheets/vis 等）禁止直连 DB；统一通过 Query Service 读取。
#
# - QUERY_SERVICE_BASE_URL：Query Service 基地址（api-service 默认端口 8088）
# - QUERY_SERVICE_AUTH_MODE：鉴权模式
#   - required：必须提供 token（推荐生产）
#   - disabled：关闭鉴权（仅限本地/受控环境调试）
# - QUERY_SERVICE_TOKEN：内部鉴权 token（Header: X-Internal-Token；required 模式必须设置）
# - QUERY_SERVICE_TIMEOUT_SECONDS：消费端请求超时（秒）
# - QUERY_SERVICE_CACHE_TTL_SECONDS：消费端（telegram/sheets）本地缓存 TTL 秒（默认 2）
# - QUERY_SERVICE_STALE_TTL_SECONDS：消费端 stale-if-error 窗口秒（默认 30）
# - QUERY_SERVICE_NET_MAX_RETRIES：消费端网络重试次数（默认 2；总尝试=1+retries）
# - QUERY_SERVICE_NET_RETRY_BASE_SECONDS：消费端重试退避 base 秒（默认 0.2；0=不 sleep）
# - QUERY_NUMERIC_MODE：指标数值输出模式（float|string；默认 float；string 保留 Decimal 精度）
# - QUERY_CACHE_MAX_ENTRIES：Query Service 内存缓存最大条数（dashboard/snapshot）
# - QUERY_DASHBOARD_CACHE_TTL_SEC：dashboard 缓存 TTL 秒（默认 2；0=关闭）
# - QUERY_SNAPSHOT_CACHE_TTL_SEC：snapshot 缓存 TTL 秒（默认 2；0=关闭）
QUERY_SERVICE_BASE_URL=http://127.0.0.1:8088
QUERY_SERVICE_AUTH_MODE=required
QUERY_SERVICE_TOKEN=<set-me-if-enabled>
QUERY_SERVICE_TIMEOUT_SECONDS=8
QUERY_SERVICE_CACHE_TTL_SECONDS=2
QUERY_SERVICE_STALE_TTL_SECONDS=30
QUERY_SERVICE_NET_MAX_RETRIES=2
QUERY_SERVICE_NET_RETRY_BASE_SECONDS=0.2
QUERY_NUMERIC_MODE=float
QUERY_CACHE_MAX_ENTRIES=256
QUERY_DASHBOARD_CACHE_TTL_SEC=2
QUERY_SNAPSHOT_CACHE_TTL_SEC=2

# api-service CORS allowlist（仅浏览器跨域访问需要；默认空=不下发 CORS 头）
# - 英文逗号/中文逗号分隔
API_CORS_ALLOW_ORIGINS=

# Query Service 多数据源 DSN（可选；留空则回退 FACTS/DERIVED 默认值）
# - indicators：indicator_snapshots.*（指标库）
# - market：facts_data.market.*（行情事实库）
# - event：facts_data.alternative.* + alternative.unified_events（事件事实库）
# - other：未来其它库
QUERY_PG_INDICATORS_URL=
QUERY_PG_MARKET_URL=
QUERY_PG_EVENT_URL=
QUERY_PG_OTHER_URL=

# Query Service：指标数据源后端（pg|sqlite；默认 pg）
# - pg：从 PostgreSQL 的 indicator_snapshots.* 读取（新架构）
# - sqlite：直接读取历史 SQLite 指标库，仅用于迁移期兼容
#   - QUERY_SQLITE_INDICATORS_PATH：历史 SQLite 指标库路径（默认会尝试兼容目录）
#   - 兼容旧环境变量：INDICATOR_SQLITE_PATH（若设置则优先使用）
QUERY_INDICATORS_BACKEND=pg
QUERY_SQLITE_INDICATORS_PATH=

# Query Service：PostgreSQL statement_timeout（毫秒）
# - 目的：避免慢查询/卡死把连接池拖住，导致请求排队雪崩
# - <=0：禁用（不设置 statement_timeout）
# - 默认：8000（8s）
QUERY_PG_STATEMENT_TIMEOUT_MS=8000

# Query Service：事件域 WebSocket（/api/v1/ws）
# - QUERY_WS_MAX_CONNECTIONS：最大并发连接数（默认 50）
# - QUERY_WS_POLL_INTERVAL_MS：轮询 unified_events 的间隔毫秒（默认 1000；最小 200）
# - QUERY_WS_IDLE_TIMEOUT_SECONDS：客户端空闲超时秒（默认 300；最小 30）
QUERY_WS_MAX_CONNECTIONS=50
QUERY_WS_POLL_INTERVAL_MS=1000
QUERY_WS_IDLE_TIMEOUT_SECONDS=300

# ============================================================
# LLM Gateway Service（nofx 外部提示词组装/决策网关）
# ============================================================
# 作为 nofx 的“OpenAI-compatible 模型端点”，对外提供：
# - GET  /healthz
# - POST /v1/chat/completions
#
# nofx 侧做法：
# - custom_api_url 指向：`http://127.0.0.1:9010/v1`
# - api_key 设置为：`LLM_GATEWAY_TOKEN`
LLM_GATEWAY_HOST=0.0.0.0
LLM_GATEWAY_PORT=9010
LLM_GATEWAY_DEBUG=false
LLM_GATEWAY_TOKEN=dev-token-change-me
LLM_GATEWAY_MODE=inject
LLM_GATEWAY_MAX_BODY_BYTES=1048576
LLM_GATEWAY_MAX_MESSAGES=32
LLM_GATEWAY_MAX_MESSAGE_CHARS=200000
LLM_GATEWAY_RUN_ASSETS_ENABLED=true
LLM_GATEWAY_RUN_ASSETS_DIR=plugins/llm-gateway/data/run_asset
LLM_GATEWAY_RUN_ASSETS_TTL_HOURS=168
LLM_GATEWAY_RUN_ASSETS_MAX_DIRS=2000
LLM_GATEWAY_CONTEXT_MD_MAX_CHARS=8000

# 原材料抓取（按服务落盘；不默认塞进 prompt）
# - 为空：不抓取（只写 query_service health/capabilities）
# - symbols 示例：BTCUSDT,ETHUSDT
# - cards 示例：volume_ranking,money_flow,macd_ranking
LLM_GATEWAY_RAW_SYMBOLS=
LLM_GATEWAY_RAW_CARDS=
LLM_GATEWAY_RAW_CARD_INTERVAL=15m
LLM_GATEWAY_RAW_CARD_LIMIT=200
LLM_GATEWAY_RAW_SNAPSHOT_PANELS=
LLM_GATEWAY_RAW_SNAPSHOT_INTERVALS=

# 上游模型（可选；不配置则网关安全降级为 wait）
# - base_url 约定：末尾加 `#` 表示“完整 URL”（不再追加 `/chat/completions`）
LLM_GATEWAY_UPSTREAM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_GATEWAY_UPSTREAM_API_KEY=
LLM_GATEWAY_UPSTREAM_MODEL=qwen3.5-plus
LLM_GATEWAY_UPSTREAM_TIMEOUT_SECONDS=30
LLM_GATEWAY_UPSTREAM_ALLOWLIST=
LLM_GATEWAY_UPSTREAM_REQUIRE_HTTPS=true
LLM_GATEWAY_UPSTREAM_BLOCK_PRIVATE=true

# Query Service：facts_data 表存在性检查缓存 TTL（秒）
# - 用于 futures 路由缺表降级时减少 information_schema 探测开销
# - 默认 30；设为 0 表示禁用 TTL（不推荐）
QUERY_MARKET_TABLE_EXISTS_TTL_SEC=30


# ============================================================
# Telegram Bot（必填）
# ============================================================
# 从 @BotFather 获取的 Bot Token
# 格式：数字:字母数字字符串（如 123456789:ABCdefGHI...）
# 获取方式：Telegram 搜索 @BotFather → /newbot → 按提示创建
BOT_TOKEN=

# Telegram 导出器（publisher / signal，可选）
# - publisher：Query 事件 JSON -> Telegram 频道
# - signal：Query 信号事件 -> Telegram 频道（人类可读）
# - 若留空：publisher/signal 会回退到 TG_CHANNEL_ID / TG_BOT_TOKENS / BOT_TOKEN
TG_CHANNEL_ID=
TG_BOT_TOKENS=
TG_PUBLISHER_CHANNEL_ID=
TG_PUBLISHER_BOT_TOKENS=
TG_PUBLISHER_EXCLUDE_TAGS=日历,交易
TG_PUBLISHER_POLL_INTERVAL=1
TG_SIGNAL_CHANNEL_ID=
TG_SIGNAL_BOT_TOKENS=
TG_SIGNAL_INCLUDE_TAGS=信号
TG_SIGNAL_POLL_INTERVAL=1

# 管理员用户ID（逗号分隔，可配置多个）
# 管理员可以访问配置面板、管理Bot设置
# 获取方式：Telegram 搜索 @userinfobot 获取你的用户ID
ADMIN_USER_IDS=

# 群聊白名单（逗号分隔，群ID通常为负数，如 -1001234567890）
# 为空时：仅响应私聊，群聊全部忽略
TELEGRAM_GROUP_WHITELIST=

# ============================================================
# Google Sheets 公共看板（sheets-service，可选）
# ============================================================
# 目标：将 TG 卡片同步到 Google Sheets（表格可公开只读，但写入必须鉴权）
#
# 推荐写入方式：Apps Script Webhook（Web App）
# - SHEETS_WEBHOOK_URL：形如 https://script.google.com/macros/s/.../exec
# - SHEETS_WEBHOOK_SECRET：HMAC 密钥（与 Apps Script 一致）
#
# 备选写入方式：Service Account + Sheets API（全 CLI，无需 Apps Script）
# - SHEETS_WRITE_MODE=sa
# - GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
# - SHEETS_SPREADSHEET_ID=...（可用 sheets-service --bootstrap 创建）
SHEETS_WRITE_MODE=webhook
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=

# Webhook 请求参数（仅影响 sheets-service 客户端）
SHEETS_WEBHOOK_TIMEOUT_SECONDS=10
SHEETS_WEBHOOK_MAX_RETRIES=3
SHEETS_WEBHOOK_BACKOFF_BASE_SECONDS=1.0
SHEETS_WEBHOOK_BACKOFF_MAX_SECONDS=30.0

# SA（Service Account）模式参数（SHEETS_WRITE_MODE=sa）
SHEETS_SPREADSHEET_ID=
SHEETS_SA_CREDENTIALS_PATH=
# （可选）若你不想保存 SA key.json：可先执行 `gcloud auth application-default login`，然后把该变量留空使用 ADC（本地开发常用）
SHEETS_SHARE_EMAIL=
SHEETS_PUBLIC_READ=0
SHEETS_DRIVE_FOLDER_ID=
# SA 写入重试（网络抖动/代理不稳定时建议增大）
# - 仅影响 SA 模式的 append/update 写入
# - 默认 2；弱网可设 3~5（注意配额与写入延迟）
SHEETS_SA_NET_WRITE_RETRIES=2
# dashboard 渲染固定列区间（默认从第一列开始，避免“整块卡片跑到 N 列以后”）
SHEETS_DASHBOARD_COL_L=A
# 多周期横向 + 全字段时列数会很大（例如超趋势：约 71 列），建议至少 BS
SHEETS_DASHBOARD_COL_R=BS
# 看板写入模式：
# - replace：按 card_type 固定槽位覆盖写（默认，不持续堆叠）
# - append：每次写入追加到末尾（审计流水视角）
SHEETS_DASHBOARD_MODE=replace

# replace 模式的槽位“最小预留高度”（行数）：
# 实际预留高度= max(最小预留高度, 该 card_type 当前渲染高度)，并记录在 meta.slot.<card_type>.h。
# 这样能避免“固定大高度”造成卡片之间巨大空洞，同时仍保留最小缓冲区。
SHEETS_DASHBOARD_SLOT_HEIGHT=10

# 事实表写入模式：
# - append：追加写入（审计台账；会持续增长，可能触发工作簿 1000 万 cells 上限）
# - none：只写看板（覆盖写），不再写 cards_index/EAV/rows/blobs
SHEETS_FACTS_MODE=append
SHEETS_BLOB_THRESHOLD_CHARS=20000

# 看板 v5：辅助隐藏 tab（可选）
# - 看板_数据：结构化长表（用于图表/透视/统计查询）
# - 看板_元信息：每张卡的元信息摘要（title/update_time/...）
# - 注意：当 `SHEETS_SCHEMA_MODE=minimal` 时，上述两项默认会自动关闭（不创建 tab）；如需仍创建请显式设为 1
SHEETS_DASHBOARD_V5_DATA_ENABLED=1
SHEETS_DASHBOARD_V5_META_ENABLED=1

# 导出语言（默认 zh_CN）
SHEETS_EXPORT_LANG=zh_CN

# 多周期横向导出（0/1）：将“周期按钮”的 7 个周期合并成一张表（每行一个币种，多列多个周期）
SHEETS_EXPORT_MULTI_PERIODS=1

# 看板/币种查询：隐藏指定周期列（仅影响展示，不删除数据）
# - 逗号分隔：例如 "1m" 或 "1m,1w"
# - 禁用：0/off/none
SHEETS_HIDE_PERIODS=1m

# 固定列宽（可选，优先级最高）：用于你在表格 UI 手工拖拽调整好列宽后固化，避免后续刷新覆盖
# - 逗号/中文逗号分隔；长度不足会用最后一个值补齐，超出会截断
# - 示例（看板 v5，9 列）：SHEETS_DASHBOARD_FIXED_COL_WIDTHS=122，36，90，86，86，86，86，86，86
SHEETS_DASHBOARD_FIXED_COL_WIDTHS=
# - 示例（币种查询，9 列）：SHEETS_SYMBOL_QUERY_FIXED_COL_WIDTHS=90，148，87，78，78，78，78，78，78
SHEETS_SYMBOL_QUERY_FIXED_COL_WIDTHS=

# 顶部广告/赞助商栏（可选）：在看板顶部新增首行（A1），用于放置赞助商/返佣信息（默认不启用）
# - 优先读：SHEETS_DASHBOARD_BANNER_TEXT；为空则回退：SHEETS_TOP_BANNER_TEXT
SHEETS_DASHBOARD_BANNER_TEXT=
SHEETS_TOP_BANNER_TEXT=

# 样式：无边框（隐藏默认网格线 + 禁止渲染可见边框分隔）
# - 只影响后续写入时的样式决策；如需对“已有边框”做全量清理，可执行：
#   sheets-service --style-borderless-all
SHEETS_STYLE_BORDERLESS=0

# 发布门禁（0/1）：写入完成后自动执行公开审计（top_rows/grid/sensitive/styles）
# - 用于 CI/运维：避免手工改表导致“对外契约”或“敏感信息”被破坏
# - 失败将返回非 0（daemon 模式会打印告警并在下轮重试）
SHEETS_PUBLIC_PUBLISH_GUARD=0

# API tab（公开读取/机器消费）：为每个非 API 表生成“单元格 JSONL”
# - 仅 SA 模式支持（需要读取各 tab 的 values 并写入 API tab）
# - 外部消费：读取 API tab 的 A 列单元格（gviz/out:csv）-> gzip+base64 解码 -> 得到结构化 JSON
SHEETS_API_ENABLE=0
# API tab 名称
SHEETS_API_TAB_TITLE=API
# 是否包含 hidden tab（0/1；默认 0）
SHEETS_API_INCLUDE_HIDDEN=0
# API tab 最小刷新间隔（秒；<=0 表示每轮都尝试）
SHEETS_API_INTERVAL_SECONDS=900
# 最多处理多少个 tab（避免误配导致读取/写入爆炸；<=0 表示不限制）
SHEETS_API_MAX_TABS=80
# （可选）仅导出指定 tab（逗号/中文逗号分隔；支持前缀通配 `看板_*`）
SHEETS_API_ONLY_TITLES=
# （可选）跳过指定 tab（逗号/中文逗号分隔；支持前缀通配 `看板_*`）
SHEETS_API_SKIP_TITLES=
# 读取二维表最大列右边界（A1 记法列号，如 BS/M/ZZ）
SHEETS_API_READ_COL_R=BS
# 读取二维表最大行数（A1 记法行号）
SHEETS_API_READ_MAX_ROWS=2000
# 单元格最大字符数软上限（超过将触发 facts 截断或降级）
SHEETS_API_MAX_CHARS=48000
# 空值占位符：导出 API payload 时会统一视为 null（缺失= null 的契约）
# - 为空则使用代码内默认：-,/,\\,／,＼,—,–,NA,N/A
SHEETS_API_NULL_MARKERS=
# 超长时：优先按 facts 条数截断（兼容 legacy：SHEETS_API_TRUNCATE_MAX_ROWS）
SHEETS_API_TRUNCATE_MAX_FACTS=1200
# 仍超长时：只保留 preview facts（兼容 legacy：SHEETS_API_TRUNCATE_PREVIEW_ROWS）
SHEETS_API_TRUNCATE_PREVIEW_FACTS=50
# legacy（兼容旧 schema：rows/metrics 口径；当前实现以 facts 为准）
SHEETS_API_TRUNCATE_MAX_ROWS=1200
SHEETS_API_TRUNCATE_MAX_METRICS=300
SHEETS_API_TRUNCATE_PREVIEW_ROWS=50
# minimal schema 的 prune_tabs 是否保留 API tab（默认 1；极少需要关闭）
SHEETS_PRUNE_KEEP_API_TAB=1

# schema 模式：
# - full：包含事实表（cards_index/EAV/rows/blobs/meta），可用于审计与重建
# - minimal：只保留“看板 + 币种查询子表”（写入量最小，推荐公开只读看板）
SHEETS_SCHEMA_MODE=full

# 同步模式：
# - dashboard：写入“看板”展示面（SA 模式下可 reset+重绘，避免堆叠）
# - snapshot：只写本轮导出的卡片（不做看板 reset；更适合 webhook）
# - append：按事件 append-only（审计流水；工作簿 cells 容量会持续增长）
SHEETS_SYNC_MODE=snapshot

# 只导出指定卡片（逗号分隔 card_id）；留空=全部排行榜卡片
# 示例：SHEETS_EXPORT_CARDS=super_trend_ranking,macd_ranking,bb_ranking
SHEETS_EXPORT_CARDS=

# 是否包含 cards registry 黑名单卡片（0/1；默认 0）
SHEETS_EXPORT_INCLUDE_BLACKLIST=0

# 币种查询子表（tab）：
# - 会按币种生成子表（默认 4 个：BTC/ETH/BNB/SOL）
# - tab 名称默认：币种查询_<SYMBOL>
SHEETS_SYMBOL_TABS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT
SHEETS_SYMBOL_TAB_PREFIX=币种查询_
# - dashboard：仅在 dashboard 模式刷新（默认，写入量最小）
# - every：每轮都刷新
# - none：不刷新币种查询子表
SHEETS_SYMBOL_TABS_MODE=dashboard
# 刷新币种查询子表的最小间隔（秒）
SHEETS_SYMBOL_TABS_INTERVAL_SECONDS=900

# 币种查询子表的“raw 数值镜像区”：
# - hidden：写入 raw 数值列但默认隐藏（推荐；用于排序/图表/条件格式）
# - show：写入 raw 数值列并显示
# - off：关闭 raw 数值列（回退为 9 列显示区）
SHEETS_SYMBOL_QUERY_RAW_MODE=hidden

# prune-tabs 是否保留“看板变体 tab”（看板_方案*）：
# - 0：仅保留 看板 + 币种查询子表（默认）
# - 1：额外保留 3 套高密度看板变体（便于对比后选型）
SHEETS_PRUNE_KEEP_DASHBOARD_VARIANTS=0

# 使用服务器数据作为数据源（推荐）：直接让 `DATABASE_URL` 指向服务器的 PostgreSQL/TimescaleDB。
# - 若服务器不开放 5433：在本机用 ssh port-forward 建立隧道，再把 DATABASE_URL 指向本机端口即可。
# - 示例（本机转发到 15433）：
#     ssh -N -L 15433:127.0.0.1:5433 nvidia@<server> -i ~/.ssh/tradecat_nvidia
#     DATABASE_URL=postgresql://postgres:postgres@localhost:15433/facts_data

# 生成看板“高密度变体”的选择器（可选，配合 --dashboard-variants）：
# - 留空：生成全部方案（1/2/3/4）
# - 示例：仅生成方案2和4：SHEETS_DASHBOARD_VARIANTS=2,4
SHEETS_DASHBOARD_VARIANTS=

# daemon 同步间隔（秒）
SHEETS_SYNC_INTERVAL_SECONDS=60

# 统一时钟刷新（0/1）：
# - 0：币种查询子表 / Polymarket 仍按各自 interval 节流（推荐，省配额）
# - 1：由 daemon tick 统一刷新：每轮把“币种查询子表 + Polymarket”也完整刷新一次（写入量更大）
SHEETS_UNIFIED_REFRESH=0

# ============================================================
# 宏观大宗（公开数据源快照，可选）
# ============================================================
# 说明：
# - 首次初始化可执行：sheets-service --publish-macro-display
#   会创建：宏观大宗看板 / 10_SNAPSHOT_WIDE / 90_SERIES_MAP / 98_REFRESH_LOG
# - 后续定时刷新快照可开启本节开关，写入到 10_SNAPSHOT_WIDE 的第2行（供“宏观大宗看板”引用展示）
SHEETS_MACRO_SNAPSHOT_ENABLE=0
# 最小刷新间隔（秒；<=0 表示每轮都尝试）
SHEETS_MACRO_SNAPSHOT_INTERVAL_SECONDS=900
# 快照表 tab 名（默认 10_SNAPSHOT_WIDE）
SHEETS_MACRO_TAB_SNAPSHOT=10_SNAPSHOT_WIDE
# 取数回溯天数（用于计算 ret_1d/5d/20d；默认 120）
SHEETS_MACRO_LOOKBACK_DAYS=120
# 数据源选择：
# - stooq：公开 CSV（默认）
# - yahoo：Yahoo Finance chart（非官方，可能限流/变更）
# - yfinance：第三方库 yfinance（更重；仍非官方）
# - auto：优先 yfinance，失败回退 stooq -> yahoo（推荐）
SHEETS_MACRO_SOURCE=auto
# HTTP 超时（秒）
SHEETS_MACRO_HTTP_TIMEOUT_SECONDS=20
# 代理策略：0=优先使用环境代理（默认）失败再直连；1=强制禁用代理优先直连
SHEETS_MACRO_DISABLE_PROXY=0
# Yahoo 429/5xx 重试次数（仅影响 yahoo source）
SHEETS_MACRO_YAHOO_RETRIES=2

# 干跑模式：只写本地 outbox 不发网络（0/1）
SHEETS_SYNC_DRY_RUN=0

# 可选：自定义 outbox 路径（默认在 sheets-service/data/）
SHEETS_OUTBOX_PATH=
SHEETS_CHECKPOINT_PATH=

# ============================================================
# Polymarket（旁路子表，可选）
# ============================================================
# 1) Polymarket统计：解析 polymarket 服务 logs 并运行 node scripts/csv-report.js 输出分段 CSV
SHEETS_TAB_POLYMARKET_STATS=Polymarket统计
# 0=禁用；1=启用；auto=启用（失败也会写入错误卡片，避免用户“看不到 tab”）
SHEETS_POLYMARKET_STATS_ENABLE=auto
SHEETS_POLYMARKET_STATS_INTERVAL_SECONDS=900
# auto=优先 ssh；ssh=远端运行 node；local=本机运行 node
SHEETS_POLYMARKET_MODE=auto
# polymarket 服务目录（包含 scripts/csv-report.js）
SHEETS_POLYMARKET_SERVICE_DIR=
# 日志路径（相对 service_dir 或绝对路径；留空则优先 $HOME/.local/state/tradecat/polymarket.log）
SHEETS_POLYMARKET_LOG_FILE=
SHEETS_POLYMARKET_MAX_LOG_MB=200
SHEETS_POLYMARKET_TIMEOUT_SECONDS=30
SHEETS_POLYMARKET_TRANSLATE=0
SHEETS_POLYMARKET_ENABLE_API_RANKINGS=0
# ssh 参数（可选；留空则不走 ssh）
SHEETS_POLYMARKET_SSH_HOST=
SHEETS_POLYMARKET_SSH_USER=
SHEETS_POLYMARKET_SSH_KEY_PATH=
SHEETS_POLYMARKET_REMOTE_SERVICE_DIR=
SHEETS_POLYMARKET_REMOTE_LOG_FILE=
SHEETS_POLYMARKET_COMPACT_GRID=1
# 冻结（阅读体验）：默认冻结到 B 列（面板列 + 关键列），并冻结到首个分段表头（元信息/目录/表头不会滚走）
SHEETS_POLYMARKET_FROZEN_COLS=2
# 留空=自动（元信息+目录+首个分段表头）；也可显式指定整数（例如 3）
SHEETS_POLYMARKET_FROZEN_ROWS=
SHEETS_PRUNE_KEEP_POLYMARKET_STATS=1

# 2) Polymarket事件：读取 polymarket 结构化 facts（JSONL），展示最近 24h 可审计视图
SHEETS_TAB_POLYMARKET_EVENTS=Polymarket事件
SHEETS_POLYMARKET_FACTS_EVENTS_ENABLE=1
SHEETS_POLYMARKET_FACTS_EVENTS_INTERVAL_SECONDS=900
SHEETS_POLYMARKET_FACTS_MODE=auto
# facts 根目录（默认 $HOME/.local/state/tradecat/polymarket/facts）
SHEETS_POLYMARKET_FACTS_DIR=
SHEETS_POLYMARKET_FACTS_EVENTS_LIMIT=400
SHEETS_POLYMARKET_FACTS_MAX_MB=10
SHEETS_POLYMARKET_FACTS_TIMEOUT_SECONDS=20
SHEETS_PRUNE_KEEP_POLYMARKET_EVENTS=1

# ============================================================
# 实时新闻（旁路子表，可选）
# ============================================================
# 说明：
# - 适合用于“内部检索/标注/审计/AI 分析”，不建议对外公开（即使隐藏 tab 也不等于不可访问）。
# - 数据源：通过 Query Service 的事件域端点读取（`/api/v1/events?tag=新闻&types=news`）。
# - 事件域端点强制鉴权（fail-closed）：必须配置 `QUERY_SERVICE_TOKEN` 并通过 Header `X-Internal-Token` 调用。

# ---------- 实时新闻 ----------
SHEETS_NEWS_ENABLE=0
SHEETS_NEWS_INTERVAL_SECONDS=300
SHEETS_TAB_NEWS=实时新闻
SHEETS_NEWS_HIDE_TAB=0
# minimal schema 的 prune_tabs 是否保留“实时新闻”tab（默认 1；建议开启，否则可能被后台清理删掉）
SHEETS_PRUNE_KEEP_NEWS_TAB=1
# minimal schema 的 prune_tabs 是否保留“新闻过滤配置”tab（默认 1；建议开启，否则在线维护黑名单/删词会被误删）
SHEETS_PRUNE_KEEP_NEWS_FILTER_TAB=1

SHEETS_NEWS_WINDOW_HOURS=24
# 建议对外消费保持紧凑：默认 200（高频写入也更稳，减少配额与单元格压力）
SHEETS_NEWS_LIMIT=200
# 高频 values-only 刷新时的硬上限（避免误配 limit=10000 导致每轮覆盖写爆配额）
SHEETS_NEWS_VALUES_ONLY_LIMIT_CAP=300
SHEETS_NEWS_MAX_TEXT_CHARS=2000
SHEETS_NEWS_TIMEOUT_SECONDS=30

# 写入前过滤（公开表 P0 合规闸门；当 SHEETS_PUBLIC_READ=1 时强制启用）
# 强制合规词（无法通过表格配置移除）：trim 至少包含 `金十数据`；blacklist 至少包含 `金十图示`,`金十数据中心工具`
SHEETS_NEWS_FILTER_ENABLE=1
# 1=优先从工作簿的 `新闻过滤配置` tab 读取（存在即用）；0=只用 repo 默认 filter.json
SHEETS_NEWS_FILTER_CONFIG_FROM_SHEET=1
# 读取配置的 TTL（秒），避免高频 values-only 刷新时 read quota 爆炸
SHEETS_NEWS_FILTER_CONFIG_TTL_SECONDS=300

# LLM 结构化评分（qwen3.5-plus）
# - 输出列：重要性分/等级/标签/理由/评分时间/模型
# - 失败降级：写入 "null"，不中断主流程
SHEETS_NEWS_LLM_ENABLE=1
SHEETS_NEWS_LLM_MODEL=qwen3.5-plus
# 留空则回退 LLM_API_BASE_URL
SHEETS_NEWS_LLM_API_BASE_URL=
# 留空则回退 EXTERNAL_API_KEY
SHEETS_NEWS_LLM_API_KEY=
SHEETS_NEWS_LLM_TIMEOUT_SECONDS=20
SHEETS_NEWS_LLM_MAX_TOKENS=256
# 每轮最多新算条数（避免高频刷新把 LLM 打爆）
SHEETS_NEWS_LLM_MAX_NEW_PER_RUN=8
SHEETS_NEWS_LLM_MAX_NEW_PER_RUN_FAST=2
SHEETS_NEWS_LLM_REASON_MAX_CHARS=80
SHEETS_NEWS_LLM_PROMPT_VERSION=news_score_v1
# 留空则默认写到 plugins/sheets/data/news_llm_cache.sqlite3
SHEETS_NEWS_LLM_CACHE_PATH=

# daemon-news 高频模式（数据流与样式维护解耦）
SHEETS_NEWS_DAEMON_INTERVAL_SECONDS=5
SHEETS_NEWS_DAEMON_LOG_INTERVAL_SECONDS=30
# 样式线程（异步）：
# - INTERVAL_SECONDS=0 表示仅启动后做一次样式修复（推荐）
# - >0 表示持续周期性重放样式
SHEETS_NEWS_STYLE_INTERVAL_SECONDS=0
SHEETS_NEWS_STYLE_RETRY_SECONDS=15
# 仅在 STYLE_INTERVAL_SECONDS=0 时生效；0 表示无限重试
SHEETS_NEWS_STYLE_MAX_RETRIES=0

# ---------- 新闻过滤配置（可选；news-services） ----------
# 目的：让 news-services 的过滤/黑名单规则“可在在线表格里改”，无需 ssh 上服务器改配置文件。
# 1) 用 sheets-service 创建模板 tab（只会引导式创建一次，不覆盖你在表格里维护的配置）：
#    - 启用：SHEETS_NEWS_FILTER_CONFIG_ENABLE=1
#    - tab 名：SHEETS_TAB_NEWS_FILTER=新闻过滤配置
#
# 2) 让 news-services 从该 tab 拉取配置（建议工作簿设为“任何人有链接可读”）：
#    URL 示例（CSV 导出）：
#    https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/gviz/tq?tqx=out:csv&sheet=<TAB_TITLE>
SHEETS_NEWS_FILTER_CONFIG_ENABLE=0
SHEETS_TAB_NEWS_FILTER=新闻过滤配置
# 1=强制覆盖写模板（危险：会覆盖表格里已编辑的配置）
SHEETS_NEWS_FILTER_CONFIG_FORCE=0

# 远程过滤配置（news-services 拉取）
NEWS_FILTER_CONFIG_URL=
NEWS_FILTER_REFRESH_MS=60000
NEWS_FILTER_CONFIG_TIMEOUT_MS=5000

# ============================================================
# 国际化（i18n）
# ============================================================
# 默认语言（与 locales 目录一致），例：zh-CN / en
DEFAULT_LOCALE=en
# 支持的语言列表（逗号分隔，需有对应翻译文件）
SUPPORTED_LOCALES=zh-CN,en
# 回退语言（翻译缺失时使用）
FALLBACK_LOCALE=zh-CN

# ============================================================
# Binance API（可选）
# ============================================================
# 用于获取账户信息、下单等功能（order-service 需要）
# 仅采集公开市场数据时可留空
# 获取方式：https://www.binance.com/zh-CN/my/settings/api-management
# 注意：建议只开启读取权限，不要开启交易权限（除非使用 order-service）
BINANCE_API_KEY=
BINANCE_API_SECRET=

# order-service 交易网关地址（可按环境覆盖）
BINANCE_REST_BASE_MAINNET=https://fapi.binance.com
BINANCE_REST_BASE_TESTNET=https://testnet.binancefuture.com
BINANCE_WS_BASE_MAINNET=wss://fstream.binance.com
BINANCE_WS_BASE_TESTNET=wss://stream.binancefuture.com
BINANCE_WEB_BASE=https://www.binance.com
BINANCE_PING_URL=https://api.binance.com/api/v3/ping
SYMBOLS_ALL_URL=https://fapi.binance.com/fapi/v1/exchangeInfo

# Binance 上游地址（全局默认，可被各服务覆盖）
BINANCE_FAPI_BASE=https://fapi.binance.com
BINANCE_DATA_BASE=https://data.binance.vision
BINANCE_ALPHA_URL=https://www.binance.com/bapi/defi/v1/public/wallet-direct/buw/wallet/cex/alpha/all/token/list

# ============================================================
# 币种管理（核心配置）
# ============================================================
# 
# SYMBOLS_GROUPS 控制采集、计算、展示哪些币种
# 此配置同时作用于：lf-service、trading-service、telegram-service
# 注：若设置了 DATA_SERVICE_DATABASE_URL，则 lf-service 会优先使用它（避免两库混淆）
# 
    # 可选值：
    #   main4  - 默认主流 4 币（BTC/ETH/SOL/BNB）
    #   main6  - 使用 SYMBOLS_GROUP_main6 定义的 6 个主流币
    #   main20 - 使用 SYMBOLS_GROUP_main20 定义的 20 个主流币
    #   auto   - 自动选择高优先级币种（约 130-150 个）
    #   all    - 全部 USDT 永续合约（600+），资源消耗大
    #   亦可组合：defi,meme 等分组并行
    #
    SYMBOLS_GROUPS=main4

# ---------- 预定义分组 ----------
# 可自定义分组，格式：SYMBOLS_GROUP_分组名=币种1,币种2,...
# 币种必须是 Binance 永续合约交易对（以 USDT 结尾）
# 可在 https://www.binance.com/zh-CN/futures/trading-rules/perpetual 查看所有交易对

# 主流币 Top 4（默认）
SYMBOLS_GROUP_main4=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT

# 主流币 Top 6（BTC、ETH、BNB、SOL、XRP、DOGE）
SYMBOLS_GROUP_main6=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,DOGEUSDT

# 主流币 Top 20
SYMBOLS_GROUP_main20=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,ADAUSDT,DOGEUSDT,AVAXUSDT,DOTUSDT,LINKUSDT,MATICUSDT,LTCUSDT,UNIUSDT,ATOMUSDT,ETCUSDT,XLMUSDT,APTUSDT,NEARUSDT,FILUSDT,ARBUSDT

# DeFi 板块（去中心化金融）
SYMBOLS_GROUP_defi=AAVEUSDT,UNIUSDT,MKRUSDT,COMPUSDT,SNXUSDT,CRVUSDT,LDOUSDT,PENDLEUSDT

# Meme 板块（模因币）
SYMBOLS_GROUP_meme=DOGEUSDT,SHIBUSDT,PEPEUSDT,FLOKIUSDT,BONKUSDT,WIFUSDT,BOMEUSDT

# AI 板块（人工智能相关）
SYMBOLS_GROUP_ai=FETUSDT,AGIXUSDT,OCEANUSDT,RENDERUSDT,TAOUSDT,ARKMUSDT

# Layer2 板块（以太坊二层扩展）
SYMBOLS_GROUP_layer2=ARBUSDT,OPUSDT,MATICUSDT,STXUSDT,IMXUSDT,METISUSDT

# ---------- 额外添加/排除 ----------
# 在分组基础上额外添加币种（逗号分隔）
# 示例：SYMBOLS_EXTRA=NEWUSDT,HOTUSDT
SYMBOLS_EXTRA=

# 强制排除的币种（逗号分隔，优先级最高，会从任何分组中移除）
# 示例：SYMBOLS_EXCLUDE=LUNAUSDT,USTCUSDT
SYMBOLS_EXCLUDE=

# ============================================================
# 周期配置
# ============================================================
# K线周期（逗号分隔）
# 可选：1m, 3m, 5m, 15m, 30m, 1h, 2h, 4h, 6h, 8h, 12h, 1d, 3d, 1w
# 周期越多，数据量和计算量越大
INTERVALS=1m,5m,15m,1h,4h,1d,1w

# K线采集周期（lf-service WebSocket 订阅使用）
KLINE_INTERVALS=1m,5m,15m,1h,4h,1d,1w

# 期货指标周期（lf-service REST API 采集使用）
# 注意：Binance 期货指标最小粒度为 5m，无 1m 数据
FUTURES_INTERVALS=5m,15m,1h,4h,1d,1w

# ============================================================
# 数据保留策略
# ============================================================
# 每个币种每个周期在 SQLite 中保留的记录条数
# 超出后自动清理旧数据，控制数据库大小
# 
# 计算公式：保留时长 = 条数 × 周期
# 例：RETENTION_1m=120 表示保留 120 分钟 = 2 小时
#     RETENTION_1d=120 表示保留 120 天 = 4 个月
#
RETENTION_1m=120
RETENTION_5m=120
RETENTION_15m=96
RETENTION_1h=144
RETENTION_4h=84
RETENTION_1d=120
RETENTION_1w=48

# ============================================================
# lf-service 配置（数据采集服务）
# ============================================================
# 
# 回填模式（首次启动或数据缺失时使用）：
#   all  - 全量回填（默认，按起始日或 10 年上限）
#   days - 按天数回填（使用 BACKFILL_DAYS）
#   none - 禁用回填
#   full 兼容映射为 all
BACKFILL_MODE=all

# 回填起始日期（可选，BACKFILL_MODE=all 时优先使用）
# 留空则默认回溯约 10 年
# 示例：BACKFILL_START_DATE=2018-01-01
BACKFILL_START_DATE=

# 回填天数（BACKFILL_MODE=days 时生效）
# 建议值：7-30 天
BACKFILL_DAYS=30

# 启动时是否先跑一次全量补齐（true/false）
BACKFILL_ON_START=false

# 最大并发请求数（控制对 Binance API 的并发访问）
# 建议值：3-10，过高可能触发限流
MAX_CONCURRENT=5

# 每分钟最大请求数（Binance 限制约 1200/分钟）
# 建议留 30% 余量，设为 800-1000
RATE_LIMIT_PER_MINUTE=1800

# WebSocket 断线重连检查间隔（秒）
# 检测 WebSocket 连接是否正常，断线后自动重连
BINANCE_WS_GAP_INTERVAL=600

# WebSocket 数据源
#   binance_ws   - 官方 WebSocket（推荐，延迟低）
#   cryptofeed   - cryptofeed 库（备用，兼容性好）
BINANCE_WS_SOURCE=binance_ws

# 守护自愈（按 DB 新鲜度重启 ws）
# 触发条件：TimescaleDB 的 candles_1m 最新 bucket_ts 距离当前时间超过阈值，且连续 N 次满足
# 注意：用于“ws 进程活着但不再写入”的自愈场景；DB 查询失败时不会强制重启（避免抖动导致重启风暴）
DATA_SERVICE_WS_DB_SELF_HEAL_ENABLED=1
DATA_SERVICE_WS_DB_STALE_MAX_AGE_SECONDS=240
DATA_SERVICE_WS_DB_STALE_CONSECUTIVE=3
DATA_SERVICE_WS_DB_SELF_HEAL_WARMUP_SECONDS=300
DATA_SERVICE_WS_DB_CHECK_CONNECT_TIMEOUT_SECONDS=3
# ban 冷却期间是否跳过 ws DB 自愈重启（避免 ban 期间重启风暴）
DATA_SERVICE_WS_DB_SELF_HEAL_SKIP_ON_BAN=1

# REST 缺口补齐并发（K线 REST 补齐）；过高容易触发 429/418（IP ban）
DATA_SERVICE_REST_BACKFILL_WORKERS=2

# lf-service 上游地址覆盖（留空则回退到 BINANCE_* 全局配置）
DATA_SERVICE_BINANCE_FAPI_BASE=
DATA_SERVICE_BINANCE_DATA_BASE=
DATA_SERVICE_BINANCE_ALPHA_URL=

# datacat-service 上游地址（可替换为网关/镜像）
DATACAT_BINANCE_FAPI_BASE=https://fapi.binance.com
DATACAT_BINANCE_DATA_BASE=https://data.binance.vision
DATACAT_BINANCE_ALPHA_URL=https://www.binance.com/bapi/defi/v1/public/wallet-direct/buw/wallet/cex/alpha/all/token/list

# ============================================================
# trading-service 配置（指标计算服务）
# ============================================================
# 
# 指标结果固定写入 PostgreSQL（indicator_snapshots.*），不再写入历史 SQLite 指标库。
# PG 指标 schema（表结构由 assets/database/db/schema/021_indicator_snapshots_sqlite_parity.sql 定义）
INDICATOR_PG_SCHEMA=indicator_snapshots
#
# PG 指标表布局（用于 indicator_snapshots 治理/收敛）
# - legacy：历史布局（每指标一表；默认）
# - dual：双写（legacy 表 + snapshots 表）
# - snapshot：Query 读 snapshots 表（仍建议保留 dual 双写用于回滚/对照）
INDICATOR_PG_LAYOUT=legacy

# 计算线程/进程数
# 建议值：CPU 核心数，过高会导致资源竞争
MAX_WORKERS=4

# 计算后端：
#   thread  - 线程池（推荐，适合 IO 密集型，内存占用低）
#   process - 进程池（适合 CPU 密集型，但内存占用高）
#   hybrid  - 混合模式（小任务用线程，大任务用进程）
COMPUTE_BACKEND=thread

# auto 模式下的高优先级币种数量上限
# 影响 SYMBOLS_GROUPS=auto 时选择的币种数量
HIGH_PRIORITY_TOP_N=50

# ---------- 指标开关 ----------
# 只启用指定指标（逗号分隔，留空=全部启用）
# 可用于调试或减少计算量
# 示例：INDICATORS_ENABLED=macd,rsi,布林带
INDICATORS_ENABLED=

# 禁用指定指标（逗号分隔）
# 示例：INDICATORS_DISABLED=k线形态,支撑阻力
INDICATORS_DISABLED=

# ============================================================
# telegram-service 配置（Telegram Bot 服务）
# ============================================================
# 
# 是否禁用 Binance API 调用（1=禁用，0=启用）
# 禁用后：不获取实时价格，使用 PG 指标库缓存数据（indicator_snapshots.*）
# 启用后：可获取实时价格，但需要配置代理
#
BINANCE_API_DISABLED=1

# ---------- 单币快照功能 ----------
# 用户发送 "BTC!" 触发单币详情查询
# 0=启用, 1=禁用（性能优化时可临时关闭）
#
DISABLE_SINGLE_TOKEN_QUERY=0

# 单币快照屏蔽字段（逗号分隔）
# 这些字段不会在单币查询表格中显示
# 示例：SNAPSHOT_HIDDEN_FIELDS=最近翻转时间,某字段
#
SNAPSHOT_HIDDEN_FIELDS=最近翻转时间

# ---------- 卡片开关 ----------
# 只启用指定卡片（逗号分隔，留空=全部启用）
# 示例：CARDS_ENABLED=资金流向,MACD,RSI
CARDS_ENABLED=

# 禁用指定卡片（逗号分隔）
# 示例：CARDS_DISABLED=K线形态,支撑阻力
CARDS_DISABLED=

# ---------- 屏蔽币种（黑名单）----------
# 这些币种不会出现在排行榜中（逗号分隔）
# 用于屏蔽已下架、异常或不想显示的币种
# 与 SYMBOLS_EXCLUDE 不同：BLOCKED_SYMBOLS 只影响展示，不影响采集和计算
BLOCKED_SYMBOLS=BNXUSDT,ALPACAUSDT

# ============================================================
# signal-service / sheets-service 状态库（PG）
# ============================================================
# 状态库固定写入 PG，不再使用本地 .db：
# - signal_runtime.*：执行 assets/database/db/schema/022_signal_runtime.sql
SIGNAL_PG_SCHEMA=signal_runtime
# - sheets_state.*：已于 2026-03-28 归档，不再作为当前真相的一部分

# ============================================================
# ai-service 配置（AI 数据服务）
# ============================================================
# 
# 控制 AI 服务从 PG(indicator_snapshots) 获取哪些指标表
# 减少表数量可显著降低 payload 大小，提升 LLM 处理效率
#

# ---------- 指标表选择 ----------
# 启用的指标表（逗号分隔，留空=全部 38 张表）
# 
AI_INDICATOR_TABLES=

# 禁用的指标表（逗号分隔，优先级高于 AI_INDICATOR_TABLES）
# 示例：AI_INDICATOR_TABLES_DISABLED=数据监控.py,期货情绪缺口监控.py
AI_INDICATOR_TABLES_DISABLED=

# ---------- LLM 调用方式 ----------
# cli: 本地 Gemini CLI（默认）
# api: 走内部 LLM API 网关
# openai_compat: 直连 OpenAI 兼容接口（只需 API Key）
LLM_BACKEND=cli

# OpenAI 兼容接口地址（示例: https://api.openai.com/v1）
LLM_API_BASE_URL=

# OpenAI 兼容接口密钥
EXTERNAL_API_KEY=

# 模型名称（openai_compat 时必填，例如 gpt-4o-mini）
LLM_MODEL=

# 最大输出 token（仅 API / openai_compat 生效）
LLM_MAX_TOKENS=32000

# 超大 payload 保护（字符数阈值）
AI_LARGE_PAYLOAD_CHAR_LIMIT=200000
# 超出阈值时强制 Gemini CLI（1=强制，0=返回错误）
AI_FORCE_GEMINI_ON_LARGE_PAYLOAD=1

# 默认提示词（CLI 或未显式指定时使用）
AI_DEFAULT_PROMPT=市场全局解析

# 运行记录开关（1=启用, 0=关闭）
AI_RECORD_ENABLED=1
# 记录内容细分开关
AI_RECORD_PAYLOAD=1
AI_RECORD_PROMPT=1
AI_RECORD_MESSAGES=1
AI_RECORD_ANALYSIS=1
# 保留最近 N 次记录（0=不限制）
AI_RECORD_MAX_DIRS=0

# ============================================================
# order-service 配置（交易执行服务）
# ============================================================
# 使用此服务需要配置 BINANCE_API_KEY 和 BINANCE_API_SECRET
# 并确保 API Key 有交易权限
# 
# 警告：交易有风险，请在测试网充分测试后再使用真实资金
# Binance 测试网：https://testnet.binancefuture.com
#
# （暂无其他配置项）

# ============================================================
# markets-service 配置（全市场数据采集服务）
# ============================================================
# 独立数据库连接（留空则复用全局 DATABASE_URL）
# 说明：
# - 若你采用 LF/HF 双集群：请按需要显式指定（分离写入），避免误连写错库
# - 若你是单集群模式：可留空复用 DATABASE_URL
MARKETS_SERVICE_DATABASE_URL=
# 默认代理（仅在 HTTP_PROXY/HTTPS_PROXY 未设置时生效）
MARKETS_SERVICE_DEFAULT_PROXY=
# 上游地址覆盖（留空则回退到 BINANCE_* 全局配置）
MARKETS_SERVICE_BINANCE_FAPI_BASE=
MARKETS_SERVICE_BINANCE_DATA_BASE=

# 加密货币写入模式（历史兼容变量）：
#   raw    - 当前真相，写入 facts_data.market.*
#   legacy - 已废弃；旧兼容 K 线口径已退场
CRYPTO_WRITE_MODE=raw

# ---------- 订单簿双层采样配置 (行业最佳实践) ----------
# L1 Tick 层: 高频采样，捕获价差/失衡信号
# L2 Full 层: 低频采样，保存完整盘口

# L1 tick 采样间隔（秒），默认 1
# 建议: 1-2s，捕获 95%+ 价差变化
ORDER_BOOK_TICK_INTERVAL=1

# L2 full 采样间隔（秒），默认 5
# 建议: 5-10s，平衡存储与精度
ORDER_BOOK_FULL_INTERVAL=5

# 每侧档位数，默认 1000（全量）
ORDER_BOOK_DEPTH=1000

# 数据保留天数
# tick 层自动保留 7 天，full 层保留此配置天数
ORDER_BOOK_RETENTION_DAYS=30

# 指定币种（可选，逗号分隔，不设则用 SYMBOLS_GROUPS）
# ORDER_BOOK_SYMBOLS=BTCUSDT,ETHUSDT

# ============================================================
# 信号服务（signal-service）
# ============================================================
# 信号数据新鲜度阈值（秒），超过则不生成信号；默认 600
SIGNAL_DATA_MAX_AGE=600

# PG 信号全局冷却时间（秒），防止重复推送；默认 300
# 与规则级冷却配合使用，持久化到 signal_runtime.cooldown
COOLDOWN_SECONDS=300

# ============================================================
# api-service 配置（REST API 服务，可选）
# ============================================================
# 监听端口（默认 8088）
API_SERVICE_PORT=8088

# ============================================================
# vis-service 配置（可视化渲染服务）
# ============================================================
# 监听地址与端口
VIS_SERVICE_HOST=0.0.0.0
VIS_SERVICE_PORT=8087

# 访问令牌（可选，若设置则所有请求需携带头 X-Vis-Token）
VIS_SERVICE_TOKEN=

# 数据源（留空默认复用全局 DATABASE_URL）
VIS_SERVICE_DATABASE_URL=

# 渲染缓存（秒）与容量
VIS_SERVICE_CACHE_TTL_SECONDS=300
VIS_SERVICE_CACHE_MAX_ITEMS=128

# ============================================================
# fate-service 配置（八字排盘服务）
# ============================================================
# 
# fate-service 使用独立的 Bot Token
#

# fate-service Bot Token（必填，从 @BotFather 获取）
FATE_BOT_TOKEN=

# fate-service 管理员 ID（逗号分隔）
FATE_ADMIN_USER_IDS=

# fate-service API 服务端口（FastAPI）
FATE_SERVICE_HOST=0.0.0.0
FATE_SERVICE_PORT=8001

